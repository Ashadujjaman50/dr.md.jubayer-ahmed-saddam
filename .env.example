# ==============================================================================
# Environment Configuration Template (Frontend-Only React + Vite)
# ==============================================================================
# NOTE: All variables prefixed with VITE_ are embedded into the client-side bundle.
# NEVER store private API keys, SMTP passwords, database URLs, or secrets here.
# ==============================================================================

# Application Meta
VITE_APP_TITLE="Dr. Md. Jubayear Ahmed Saddam | Surgical Portfolio"

# Future Email Service Configuration (Optional)
# When ready to enable client-safe email services (e.g., EmailJS public key or serverless endpoint):
VITE_EMAIL_SERVICE_ENABLED=false
VITE_EMAIL_PROVIDER_PUBLIC_KEY=your_safe_public_key_here
VITE_EMAIL_TEMPLATE_ID=your_template_id_here
VITE_EMAIL_SERVICE_ID=your_service_id_here
